# BrandGuard AI Environment Configuration
# Team: Reverse Engg (Shivam Gupta, Uzma Nayab, Aaysha Shams)

APP_NAME=BrandGuard AI
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Fallback local SQLite:
DATABASE_URL=sqlite:///./brandguard.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://brandguard_user:securepassword@localhost:5432/brandguard

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# AI Service Configuration
# Optional: Provide Google Gemini API Key for deep semantic analysis
# If not provided, BrandGuard AI uses its full deterministic rule-based compliance engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
